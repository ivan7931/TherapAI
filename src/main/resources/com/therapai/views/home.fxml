<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #0A0F1F;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.therapai.controllers.HomeController">
   <center>
      <AnchorPane prefHeight="400.0" prefWidth="600.0">
         <children>
            <VBox alignment="CENTER" layoutX="115.0" layoutY="39.0" prefHeight="423.0" prefWidth="670.0" spacing="20.0" style="-fx-background-color: #111A2E; -fx-background-radius: 8;">
               <children>
                  <Button mnemonicParsing="false" onAction="#newChat" prefHeight="45.0" prefWidth="201.0" style="-fx-background-color: #4DA3FF; -fx-text-fill: #0A0F1F; -fx-background-radius: 10;" text="Nuevo chat">
                     <font>
                        <Font size="18.0" />
                     </font>
                     <padding>
                        <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                     </padding>
                     <VBox.margin>
                        <Insets top="20.0" />
                     </VBox.margin>
                  </Button>
                  <Label style="-fx-text-fill: #E6F0FF;" text="Tus chats">
                     <font>
                        <Font size="20.0" />
                     </font>
                  </Label>
                  <ListView fx:id="chatList" onMouseClicked="#openChat" prefHeight="305.0" prefWidth="630.0" style="-fx-background-color: #111A2E; -fx-border-color: #4DA3FF; -fx-border-width: 1; -fx-border-radius: 7;">
                     <VBox.margin>
                        <Insets bottom="15.0" left="20.0" right="20.0" />
                     </VBox.margin>
                  </ListView>
               </children>
            </VBox>
         </children>
      </AnchorPane>
   </center>
   <top>
      <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="20.0" style="-fx-background-color: #111A2E;" BorderPane.alignment="CENTER">
         <children>
            <ImageView fitHeight="100.0" fitWidth="100.0" onMouseClicked="#goHome" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../images/LogoSinLetra.png" />
               </image>
            </ImageView>
            <Label prefHeight="40.0" prefWidth="134.0" text="TherapAI" textFill="#4da3ff">
               <font>
                  <Font size="25.0" />
               </font>
            </Label>
            <Region prefHeight="150.0" prefWidth="287.0" />
            <Button mnemonicParsing="false" style="-fx-background-color: #111A2E; -fx-text-fill: #0A0F1F; -fx-background-radius: 10;">
               <graphic>
                  <ImageView fitHeight="50.0" fitWidth="50.0" onMouseClicked="#goHistory" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../images/HistoryIcon.png" />
                     </image>
                  </ImageView>
               </graphic>
            </Button>
            <Button mnemonicParsing="false" style="-fx-background-color: #111A2E; -fx-text-fill: #0A0F1F; -fx-background-radius: 10;">
               <graphic>
                  <ImageView fitHeight="50.0" fitWidth="50.0" onMouseClicked="#goSettings" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../images/SettingsIcon.png" />
                     </image>
                  </ImageView>
               </graphic>
            </Button>
            <Button mnemonicParsing="false" style="-fx-background-color: #111A2E; -fx-text-fill: #0A0F1F; -fx-background-radius: 10;">
               <graphic>
                  <ImageView fitHeight="50.0" fitWidth="50.0" onMouseClicked="#goProfile" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../images/ProfileIcon.png" />
                     </image>
                  </ImageView>
               </graphic>
            </Button>
         </children>
      </HBox>
   </top>
</BorderPane>
